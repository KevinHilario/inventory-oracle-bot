# Completa los valores únicamente en tu archivo local .env.
# No agregues contraseñas, tokens ni claves reales a este archivo de plantilla.
APP_PORT=
DB_PORT=
POSTGRES_DB=
POSTGRES_USER=
POSTGRES_PASSWORD=

# Claude (Supervisor multiagente). Sin clave, el sistema responde con reglas.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
SUPERVISOR_DAILY_LIMIT=200

# Opcional: base externa (p. ej. Neon). Tiene prioridad sobre PGHOST/PGUSER/...
DATABASE_URL=
